MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=face_temphora

# SSL (mesmo padrão do Node mysql2)
# - MYSQL_SSL=true ativa SSL/TLS.
# - MYSQL_SSL_REJECT_UNAUTHORIZED=true valida o cert do servidor (recomendado).
#   Coloque false só pra debug com cert self-signed.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
